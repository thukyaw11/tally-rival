{
	"name": "Tally · Scrabble scores",
	"short_name": "Tally",
	"description": "Scrabble board and score tracker for 2–4 players.",
	"start_url": "./",
	"scope": "./",
	"display": "standalone",
	"orientation": "portrait",
	"background_color": "#e7e5e4",
