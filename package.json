{
	"name": "tally",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "bun run --filter @tally/web dev",
		"build": "bun run --filter @tally/web build",
		"check": "bun run --filter '*' check",
		"lint": "bun run --filter '*' lint",
		"format": "bun run --filter '*' format",
		"test": "bun run --filter '*' test"
	}
}
